# === Supabase (nieuw HR-project) ===
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...          # publiek, gaat naar de browser
SUPABASE_SERVICE_KEY=eyJ...       # geheim, alleen in functions

# === Google Sheets (service account) ===
# Service account, compact (AWS Lambda: max. 4 KB env vars per function).
# Maak beide waarden met:  node scripts/sa-compact.js service-account.json
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=
# (oud, alleen lokaal nog bruikbaar: GOOGLE_SA_JSON_B64=)

# === Shiftbase ===
SHIFTBASE_KEY=

# === Mail (Resend) ===
RESEND_API_KEY=re_...              # geheim; domein ilovesla.com moet in Resend geverifieerd zijn
MAIL_FROM=SLA HR Team <hr@ilovesla.com>

# === Toegang ===
TOEGANG_DOMEIN=ilovesla.com       # alleen Google-accounts van dit domein

# === Signaleringen (stap 4) ===
# '1' = de scheduled functions mailen en schrijven echt. Leeg = droogloop (alleen rapporteren).
# Pas aanzetten op het moment dat de Apps Script-triggers uit gaan, anders dubbele mails.
SIGNALERINGEN_ACTIEF=

# Optioneel: eigen sleutel voor de getekende upload-links (anders afgeleid van SUPABASE_SERVICE_KEY). Wijzigen = oude links ongeldig.
# UPLOAD_SECRET=
# Optioneel: basis-URL in de upload-links (standaard Netlify's URL / https://slahrmanager.netlify.app)
# UPLOAD_SITE=
